<Window x:Class="LokuOn.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:LokuOn.App.Controls"
        Title="LokuOn" Width="1280" Height="880" MinWidth="1040" MinHeight="660"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" FontSize="12"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== プリセット ===== -->
        <Button x:Name="BtnSettings" Grid.Row="0" Content="⚙" FontSize="16" Width="34" Height="30" Padding="0"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0" Panel.ZIndex="5"
                ToolTip="歯車: 画面の色・スリープ防止・最小化の動作・ヘルプ・バージョン情報・GitHub"/>
        <Button x:Name="BtnOutput" Grid.Row="0" Content="🔊" FontSize="14" Width="34" Height="30" Padding="0"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,46,0" Panel.ZIndex="5"
                ToolTip="出力: 入力の音をスピーカーやVB-CABLEなどの再生デバイスへ流します(録音とは独立)"/>
        <WrapPanel Grid.Row="0" Margin="8,6,90,2" VerticalAlignment="Center">
            <TextBlock Text="プリセット" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="PresetCombo" Width="240" Margin="0,0,6,0"/>
            <Button x:Name="BtnPresetSave" Content="上書き保存" Padding="10,2" Margin="0,0,4,0"/>
            <Button x:Name="BtnPresetSaveAs" Content="名前を付けて保存" Padding="10,2" Margin="0,0,4,0"/>
            <Button x:Name="BtnPresetDelete" Content="削除" Padding="10,2" Margin="0,0,16,0"/>
            <Button x:Name="BtnPresetFolder" Content="Presetsフォルダを開く" Padding="10,2" Margin="0,0,16,0"
                    ToolTip="プリセットは「名前.json」として自動保存されます。ファイルをコピーして共有したり、削除したりできます。"/>
            <TextBlock x:Name="PresetHint" VerticalAlignment="Center" Opacity="0.7"/>
            <TextBlock x:Name="PresetError" VerticalAlignment="Center" Foreground="#E5484D" FontWeight="SemiBold" Visibility="Collapsed" Margin="8,0,0,0"/>
        </WrapPanel>

        <Grid Grid.Row="1" Margin="8,4,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左: 設定 ===== -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="LockPanel">

                    <GroupBox Header="入力デバイス(最大4台。PC内部音 / マイク / ASIO)" Margin="0,0,0,6" Padding="6,4">
                        <StackPanel>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="44"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="InName1" Text="入力1" VerticalAlignment="Center" Margin="0,0,6,0" MaxWidth="100" TextTrimming="CharacterEllipsis" ToolTip="ダブルクリックで名前を変更"/>
                                <ComboBox x:Name="DevCombo1" Grid.Column="1"/>
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="44"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="InName2" Text="入力2" VerticalAlignment="Center" Margin="0,0,6,0" MaxWidth="100" TextTrimming="CharacterEllipsis" ToolTip="ダブルクリックで名前を変更"/>
                                <ComboBox x:Name="DevCombo2" Grid.Column="1"/>
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="44"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="InName3" Text="入力3" VerticalAlignment="Center" Margin="0,0,6,0" MaxWidth="100" TextTrimming="CharacterEllipsis" ToolTip="ダブルクリックで名前を変更"/>
                                <ComboBox x:Name="DevCombo3" Grid.Column="1"/>
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="44"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="InName4" Text="入力4" VerticalAlignment="Center" Margin="0,0,6,0" MaxWidth="100" TextTrimming="CharacterEllipsis" ToolTip="ダブルクリックで名前を変更"/>
                                <ComboBox x:Name="DevCombo4" Grid.Column="1"/>
                            </Grid>
                            <WrapPanel Margin="0,2,0,0">
                                <TextBlock Text="複数のとき:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <RadioButton x:Name="MixModeMix" Content="ミックスして1ファイル" GroupName="Mix" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                                <RadioButton x:Name="MixModeSep" Content="デバイスごとに別ファイル" GroupName="Mix" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                                <Button x:Name="BtnRefreshDevices" Content="デバイス再取得" Padding="8,2"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="音質・形式" Margin="0,0,0,6" Padding="6,4">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="形式" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="FormatCombo" Width="130" Margin="0,0,12,3"/>
                                <TextBlock Text="サンプリング" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="RateCombo" Width="100" Margin="0,0,12,3"/>
                                <TextBlock Text="チャンネル" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="ChannelsCombo" Width="100" Margin="0,0,12,3"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock x:Name="BitrateLabel" Text="ビットレート" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="BitrateCombo" Width="110" Margin="0,0,12,3"/>
                                <TextBlock x:Name="BitDepthLabel" Text="ビット深度" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="BitDepthCombo" Width="110" Margin="0,0,12,3"/>
                                <TextBlock x:Name="CompressionLabel" Text="圧縮率" VerticalAlignment="Center" Margin="0,0,4,0"
                                           ToolTip="大きいほどファイルが小さくなりますが、処理が重くなります(音質は変わりません)。Ogg(Vorbis)には設定がありません。"/>
                                <ComboBox x:Name="CompressionCombo" Width="110" Margin="0,0,12,3"/>
                            </WrapPanel>
                            <TextBlock x:Name="QualitySummary" Opacity="0.75" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="保存先とファイル名" Margin="0,0,0,6" Padding="6,4">
                        <StackPanel>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="保存先" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="FolderBox" Grid.Column="1" VerticalContentAlignment="Center"/>
                                <Button x:Name="BtnBrowse" Grid.Column="2" Content="参照…" Padding="8,2" Margin="4,0,0,0"/>
                                <Button x:Name="BtnOpenFolder" Grid.Column="3" Content="開く" Padding="8,2" Margin="4,0,0,0"/>
                            </Grid>
                            <WrapPanel Margin="0,0,0,3">
                                <CheckBox x:Name="UseDateFolderCheck" Content="日付フォルダを作る" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="DateFormatBox" Width="200" VerticalContentAlignment="Center" ToolTip="例: {yyyy}-{MM}-{dd}（録音を始めた日で固定）"/>
                            </WrapPanel>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="テンプレート" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="TemplateCombo" Grid.Column="1"/>
                                <WrapPanel Grid.Column="2" Margin="4,0,0,0">
                                    <Button x:Name="BtnTemplateSave" Content="保存" Padding="8,2" Margin="0,0,4,0"/>
                                    <Button x:Name="BtnTemplateDelete" Content="削除" Padding="8,2" Margin="0,0,4,0"/>
                                    <Button x:Name="BtnTemplateReset" Content="初期に戻す" Padding="8,2"/>
                                </WrapPanel>
                            </Grid>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ファイル名" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TemplateBox" Grid.Column="1" VerticalContentAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="TemplatePreview" TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="SemiBold"/>
                            <Expander Header="ファイル名の詳細(変数・時間表記・番号)" Margin="0,2,0,0">
                                <StackPanel Margin="0,4,0,0">
                            <TextBlock x:Name="TemplateHint" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,2"
                                       Text="{}変数: {Date} {Time} {yyyy} {yy} {MM} {dd} {HH} {mm} {ss}(そのファイルを始めた時刻) {No} {Track:000} {Start} {End} {Length} {Device} {Preset} {ext}   {End:m}=125：30 形式 / {End:s}=秒数"/>
                            <WrapPanel Margin="0,0,0,3">
                                <TextBlock Text="時間表記" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="TimeStyleCombo" MinWidth="250"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="次のNo." VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="NoBox" Width="56" VerticalContentAlignment="Center" Margin="0,0,12,0"
                                         ToolTip="録音が終わるたびに+1されます。アプリを閉じても保持されます。"/>
                                <TextBlock Text="開始Track" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="TrackBox" Width="56" VerticalContentAlignment="Center"
                                         ToolTip="録音を始めるときのトラック番号。分割するたびに+1されます。"/>
                            </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="分割・自動操作" Margin="0,0,0,6" Padding="6,4">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,3">
                                <TextBlock Text="自動分割" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="AutoSplitBox" Width="76" VerticalContentAlignment="Center" TextAlignment="Center"
                                         ToolTip="この間隔ごとに、自動でファイルを分割します。時:分:秒 で指定(00:00:00 = 自動分割しない)。24:00:00 まで。"/>
                                <TextBlock Text="ごと(時:分:秒、00:00:00=しない)" VerticalAlignment="Center" Margin="4,0,14,0"/>
                                <TextBlock Text="安全上限" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="MaxHoursBox" Width="40" VerticalContentAlignment="Center"
                                         ToolTip="1つのファイルがこの時間を超えないように、必ず分割します(安全のための上限。初期値24時間)。"/>
                                <TextBlock Text="時間" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </WrapPanel>
                            <TextBlock x:Name="SplitHint" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock x:Name="SplitError" Foreground="#E5484D" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,4"/>
                            <Expander Header="オプション(無音で分割・音で録音開始・デバイス切断時の動作)" Margin="0,2,0,0">
                                <StackPanel Margin="0,4,0,0">
                            <WrapPanel Margin="0,0,0,3">
                                <CheckBox x:Name="SilenceSplitCheck" Content="無音で分割" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="SilenceDbBox" Width="46" VerticalContentAlignment="Center"/>
                                <TextBlock Text="dB以下が" VerticalAlignment="Center" Margin="4,0,4,0"/>
                                <TextBox x:Name="SilenceSecBox" Width="40" VerticalContentAlignment="Center"/>
                                <TextBlock Text="秒続いたら(1曲最短" VerticalAlignment="Center" Margin="4,0,4,0"/>
                                <TextBox x:Name="MinTrackBox" Width="40" VerticalContentAlignment="Center"/>
                                <TextBlock Text="秒)" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,3">
                                <CheckBox x:Name="AutoStartCheck" Content="音が出たら録音開始" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="AutoStartDbBox" Width="46" VerticalContentAlignment="Center"/>
                                <TextBlock Text="dB以上" VerticalAlignment="Center" Margin="4,0,14,0"/>
                                <TextBlock Text="無音で自動停止" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="AutoStopBox" Width="44" VerticalContentAlignment="Center"/>
                                <TextBlock Text="秒(0=しない)" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </WrapPanel>
                            <WrapPanel>
                                <CheckBox x:Name="AutoResumeCheck" Content="デバイス切断時に自動再開" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="LostPolicyCombo" Width="230"/>
                            </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <!-- ===== 右: モニター + タブ ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderThickness="1" BorderBrush="#55808080" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 経過時間など -->
                        <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="ElapsedText" Text="0:00:00" FontSize="34" FontWeight="SemiBold" Margin="0,0,16,0" FontFamily="Consolas, Yu Gothic UI"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="StateText" Text="待機中" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TrackInfoText" Text="" Opacity="0.8"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="DiskText" Text="" Opacity="0.8"/>
                                <TextBlock x:Name="FileNameText" Text="" Opacity="0.8" TextTrimming="CharacterEllipsis" MaxWidth="460"/>
                            </StackPanel>
                        </WrapPanel>

                        <!-- ボタン -->
                        <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top">
                            <Button x:Name="BtnRecord" Content="●  録音開始" Width="150" Height="46" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Button x:Name="BtnPauseRec" Content="❚❚  一時停止" Width="150" Height="38" FontSize="14" IsEnabled="False" Margin="0,0,0,6"/>
                            <Button x:Name="BtnSplit" Content="✂  分割" Width="150" Height="38" FontSize="14" IsEnabled="False" Margin="0,0,0,6"/>
                            <CheckBox x:Name="MonitorCheck" Content="入力確認(待機中も表示)" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- 波形 -->
                        <Border Grid.Row="1" Grid.Column="0" Margin="0,6,0,6" BorderThickness="1" BorderBrush="#55808080">
                            <c:WaveformView x:Name="WaveView" Height="86"/>
                        </Border>

                        <!-- メーターとゲイン -->
                        <Grid Grid.Row="2" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="出力レベル(dB)" Opacity="0.7" Margin="0,0,0,2"/>
                                <c:LevelMeter x:Name="MasterMeter" Margin="0,0,0,6"/>
                                <TextBlock Text="入力ごとのレベル" Opacity="0.7" Margin="0,0,0,2"/>
                                <c:LevelMeter x:Name="SourceMeter"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ゲイン(録音中も調整できます / ダブルクリックで0dB)" Opacity="0.7" Margin="0,0,0,2"/>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="全体" VerticalAlignment="Center"/>
                                    <Slider x:Name="MasterGain" Grid.Column="1" Minimum="-30" Maximum="30" Value="0" SmallChange="0.5" LargeChange="3" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MasterGainText" Grid.Column="2" Text="+0.0 dB" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GName1" Text="入力1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Slider x:Name="Gain1" Grid.Column="1" Minimum="-30" Maximum="20" Value="0" SmallChange="0.5" LargeChange="3" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Gain1Text" Grid.Column="2" Text="+0.0 dB" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GName2" Text="入力2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Slider x:Name="Gain2" Grid.Column="1" Minimum="-30" Maximum="20" Value="0" SmallChange="0.5" LargeChange="3" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Gain2Text" Grid.Column="2" Text="+0.0 dB" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GName3" Text="入力3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Slider x:Name="Gain3" Grid.Column="1" Minimum="-30" Maximum="20" Value="0" SmallChange="0.5" LargeChange="3" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Gain3Text" Grid.Column="2" Text="+0.0 dB" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GName4" Text="入力4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Slider x:Name="Gain4" Grid.Column="1" Minimum="-30" Maximum="20" Value="0" SmallChange="0.5" LargeChange="3" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Gain4Text" Grid.Column="2" Text="+0.0 dB" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- エラー(音の鳴るポップアップではなく、ここに赤文字で出す) -->
                        <TextBlock x:Name="ErrorText" Grid.Row="3" Grid.ColumnSpan="2" Foreground="#E5484D" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6,0,0" VerticalAlignment="Top"/>
                        <!-- メッセージ -->
                        <ListBox x:Name="LogList" Grid.Row="4" Grid.ColumnSpan="2" Height="64" Margin="0,6,0,0" FontSize="11"/>
                    </Grid>
                </Border>

                <TabControl x:Name="Tabs" Grid.Row="1">
                    <TabItem Header="録音ファイル">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- プレイヤー -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnPlay" Grid.Column="0" Content="▶ 再生" Width="72" Margin="0,0,4,0"/>
                                <Button x:Name="BtnStopPlay" Grid.Column="1" Content="■" Width="36" Margin="0,0,8,0"/>
                                <Slider x:Name="SeekSlider" Grid.Column="2" Minimum="0" Maximum="1" VerticalAlignment="Center" IsMoveToPointEnabled="True"/>
                                <TextBlock x:Name="PlayPosText" Grid.Column="3" Text="0:00 / 0:00" Margin="8,0,8,0" VerticalAlignment="Center" MinWidth="96" TextAlignment="Center"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,8,0">
                                    <TextBlock Text="速度" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox x:Name="SpeedCombo" Width="78"/>
                                </StackPanel>
                                <StackPanel Grid.Column="5" Orientation="Horizontal">
                                    <TextBlock Text="音量" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Slider x:Name="VolumeSlider" Width="80" Minimum="0" Maximum="1" Value="0.8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- 一覧(Windows 11のFluentテーマではGridViewが表示されないため、1行ずつのテンプレートで作る) -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="12,0,0,3" Opacity="0.75">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="360"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ファイル名"/>
                                    <TextBlock Grid.Column="1" Text="長さ" TextAlignment="Right" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="2" Text="サイズ" TextAlignment="Right" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="3" Text="日時"/>
                                </Grid>
                                <ListView x:Name="FileList" Grid.Row="1" SelectionMode="Extended">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="360"/>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="76"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DurationText}" TextAlignment="Right" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" TextAlignment="Right" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding TimeText}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>

                            <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                                <Button x:Name="BtnReveal" Content="フォルダを開く" Padding="10,2" Margin="0,0,6,0"/>
                                <Button x:Name="BtnRename" Content="名前を変更" Padding="10,2" Margin="0,0,6,0"/>
                                <Button x:Name="BtnTrash" Content="ごみ箱へ" Padding="10,2" Margin="0,0,6,0"/>
                                <Button x:Name="BtnRescan" Content="保存先から読み込み" Padding="10,2" Margin="0,0,12,0"/>
                                <TextBlock x:Name="FileCountText" VerticalAlignment="Center" Opacity="0.7"/>
                                <TextBlock x:Name="FileError" VerticalAlignment="Center" Foreground="#E5484D" FontWeight="SemiBold" Visibility="Collapsed" Margin="12,0,0,0"/>
                            </WrapPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="タグ(メタデータ)">
                        <StackPanel Margin="10">
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                                       Text="{}空欄のものは書き込みません。{No} {Track} {Date} などの変数も使えます。日本語はUTF-8で正しく保存されます。"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="タイトル" VerticalAlignment="Center"/>
                                <TextBox x:Name="TagTitle" Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="アーティスト" VerticalAlignment="Center"/>
                                <TextBox x:Name="TagArtist" Grid.Row="0" Grid.Column="4" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="アルバム" VerticalAlignment="Center"/>
                                <TextBox x:Name="TagAlbum" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="アルバムアーティスト" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <TextBox x:Name="TagAlbumArtist" Grid.Row="1" Grid.Column="4" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="ジャンル" VerticalAlignment="Center"/>
                                <TextBox x:Name="TagGenre" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="年" VerticalAlignment="Center"/>
                                <TextBox x:Name="TagYear" Grid.Row="2" Grid.Column="4" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="コメント" VerticalAlignment="Center"/>
                                <TextBox x:Name="TagComment" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,0,0,4"/>
                            </Grid>
                            <CheckBox x:Name="WriteTrackTagCheck" Margin="0,8,0,0"
                                      Content="分割したときだけ、トラック番号タグを付ける(分割しない録音には付けません)"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="アプリ設定">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <TextBlock Text="画面の色・スリープ防止・最小化の動作・ヘルプ・バージョン情報は、右上の ⚙ ボタンから変更できます。" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ConfirmCloseCheck" Content="録音中にアプリを閉じようとしたら警告する" Margin="0,0,0,8"/>
                                <WrapPanel Margin="0,0,0,4">
                                    <CheckBox x:Name="HotkeysCheck" Content="グローバルホットキーを使う" Margin="0,0,12,0" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="録音開始/停止" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="HotkeyStartBox" Width="120" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="分割" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="HotkeySplitBox" Width="120" VerticalContentAlignment="Center"/>
                                </WrapPanel>
                                <TextBlock x:Name="HotkeyStatus" Opacity="0.75" Margin="0,0,0,8" TextWrapping="Wrap"
                                           Text="例: Ctrl+Alt+F9 (Ctrl / Alt / Shift / Win と、英数字・F1〜F24 などの組み合わせ)"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock Text="ディスク空き容量: 警告" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="DiskWarnBox" Width="46" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="GB未満 / 自動停止して保存" VerticalAlignment="Center" Margin="4,0,4,0"/>
                                    <TextBox x:Name="DiskStopBox" Width="46" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="GB未満" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </WrapPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ffmpeg.exe の場所" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="FfmpegBox" Grid.Column="1" VerticalContentAlignment="Center" ToolTip="空欄なら ffmpeg フォルダ内を自動で探します"/>
                                    <Button x:Name="BtnFfmpegBrowse" Grid.Column="2" Content="参照…" Padding="8,2" Margin="4,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="FfmpegStatus" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock x:Name="DataDirText" Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="予約録音">
                        <StackPanel Margin="10">
                            <CheckBox x:Name="ScheduleCheck" Content="予約録音を有効にする(アプリを起動しておく必要があります)" Margin="0,0,0,8"/>
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="開始日" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <DatePicker x:Name="ScheduleDate" Width="140" Margin="0,0,12,0"/>
                                <TextBlock Text="開始時刻(24時間表記)" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="ScheduleTimeBox" Width="60" VerticalContentAlignment="Center" Margin="0,0,12,0" ToolTip="例: 21:30"/>
                                <TextBlock Text="録音時間" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="ScheduleMinutesBox" Width="60" VerticalContentAlignment="Center"/>
                                <TextBlock Text="分" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </WrapPanel>
                            <CheckBox x:Name="ScheduleDailyCheck" Content="毎日くり返す" Margin="0,0,0,8"/>
                            <TextBlock x:Name="ScheduleStatus" Opacity="0.8" TextWrapping="Wrap"/>
                            <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="予約の時刻になると、そのときの画面の設定で録音を始め、指定の時間で自動的に止めます。"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ===== ステータスバー ===== -->
        <DockPanel Grid.Row="2" Margin="8,2,8,6" LastChildFill="True">
            <TextBlock x:Name="StatusText" Text="" Opacity="0.85" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
