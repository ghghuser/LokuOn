<Window x:Class="LokuOn.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:LokuOn.App.Controls"
        xmlns:ui="clr-namespace:LokuOn.App"
        Title="LokuOn" Width="1280" Height="880" MinWidth="1040" MinHeight="660"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" FontSize="12"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== プリセット ===== -->
        <Button x:Name="BtnSettings" Grid.Row="0" Content="⚙" FontSize="16" Width="34" Height="30" Padding="0"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0" Panel.ZIndex="5"
                ToolTip="{ui:T main.btnSettings.tip}"/>
        <Button x:Name="BtnOutput" Grid.Row="0" Content="🔊" FontSize="14" Width="34" Height="30" Padding="0"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,46,0" Panel.ZIndex="5"
                ToolTip="{ui:T main.btnOutput.tip}"/>
        <WrapPanel Grid.Row="0" Margin="8,6,90,2" VerticalAlignment="Center">
            <TextBlock Text="{ui:T main.top.01}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="PresetCombo" Width="240" Margin="0,0,6,0"/>
            <Button x:Name="BtnPresetSave" Content="{ui:T main.btnPresetSave}" Padding="10,2" Margin="0,0,4,0"/>
            <Button x:Name="BtnPresetSaveAs" Content="{ui:T main.btnPresetSaveAs}" Padding="10,2" Margin="0,0,4,0"/>
            <Button x:Name="BtnPresetDelete" Content="{ui:T main.btnPresetDelete}" Padding="10,2" Margin="0,0,16,0"/>
            <Button x:Name="BtnPresetFolder" Content="{ui:T main.btnPresetFolder}" Padding="10,2" Margin="0,0,16,0"
                    ToolTip="{ui:T main.btnPresetFolder.tip}"/>
            <TextBlock x:Name="PresetHint" VerticalAlignment="Center" Opacity="0.7"/>
            <TextBlock x:Name="PresetError" VerticalAlignment="Center" Foreground="#E5484D" FontWeight="SemiBold" Visibility="Collapsed" Margin="8,0,0,0"/>
        </WrapPanel>

        <Grid Grid.Row="1" Margin="8,4,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左: 設定 ===== -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="LockPanel">

                    <GroupBox Header="{ui:T main.input.01}" Margin="0,0,0,6" Padding="6,4">
                        <StackPanel>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="44"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="InName1" Text="{ui:T main.inName1}" VerticalAlignment="Center" Margin="0,0,6,0" MaxWidth="100" TextTrimming="CharacterEllipsis" ToolTip="{ui:T main.inName1.tip}"/>
                                <ComboBox x:Name="DevCombo1" Grid.Column="1"/>
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="44"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="InName2" Text="{ui:T main.inName2}" VerticalAlignment="Center" Margin="0,0,6,0" MaxWidth="100" TextTrimming="CharacterEllipsis" ToolTip="{ui:T main.inName1.tip}"/>
                                <ComboBox x:Name="DevCombo2" Grid.Column="1"/>
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="44"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="InName3" Text="{ui:T main.inName3}" VerticalAlignment="Center" Margin="0,0,6,0" MaxWidth="100" TextTrimming="CharacterEllipsis" ToolTip="{ui:T main.inName1.tip}"/>
                                <ComboBox x:Name="DevCombo3" Grid.Column="1"/>
                            </Grid>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="44"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="InName4" Text="{ui:T main.inName4}" VerticalAlignment="Center" Margin="0,0,6,0" MaxWidth="100" TextTrimming="CharacterEllipsis" ToolTip="{ui:T main.inName1.tip}"/>
                                <ComboBox x:Name="DevCombo4" Grid.Column="1"/>
                            </Grid>
                            <WrapPanel Margin="0,2,0,0">
                                <TextBlock Text="{ui:T main.input.02}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <RadioButton x:Name="MixModeMix" Content="{ui:T main.mixModeMix}" GroupName="Mix" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                                <RadioButton x:Name="MixModeSep" Content="{ui:T main.mixModeSep}" GroupName="Mix" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                                <Button x:Name="BtnRefreshDevices" Content="{ui:T main.btnRefreshDevices}" Padding="8,2"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{ui:T main.format.01}" Margin="0,0,0,6" Padding="6,4">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="{ui:T main.format.02}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="FormatCombo" Width="130" Margin="0,0,12,3"/>
                                <TextBlock Text="{ui:T main.format.03}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="RateCombo" Width="100" Margin="0,0,12,3"/>
                                <TextBlock Text="{ui:T main.format.04}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="ChannelsCombo" Width="100" Margin="0,0,12,3"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock x:Name="BitrateLabel" Text="{ui:T main.bitrateLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="BitrateCombo" Width="110" Margin="0,0,12,3"/>
                                <TextBlock x:Name="BitDepthLabel" Text="{ui:T main.bitDepthLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="BitDepthCombo" Width="110" Margin="0,0,12,3"/>
                                <TextBlock x:Name="CompressionLabel" Text="{ui:T main.compressionLabel}" VerticalAlignment="Center" Margin="0,0,4,0"
                                           ToolTip="{ui:T main.compressionLabel.tip}"/>
                                <ComboBox x:Name="CompressionCombo" Width="110" Margin="0,0,12,3"/>
                            </WrapPanel>
                            <TextBlock x:Name="QualitySummary" Opacity="0.75" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{ui:T main.save.01}" Margin="0,0,0,6" Padding="6,4">
                        <StackPanel>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{ui:T main.save.02}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="FolderBox" ToolTip="{ui:T main.folderBox.tip}" Grid.Column="1" VerticalContentAlignment="Center"/>
                                <Button x:Name="BtnBrowse" Grid.Column="2" Content="{ui:T main.btnBrowse}" Padding="8,2" Margin="4,0,0,0"/>
                                <Button x:Name="BtnOpenFolder" Grid.Column="3" Content="{ui:T main.btnOpenFolder}" Padding="8,2" Margin="4,0,0,0"/>
                            </Grid>
                            <WrapPanel Margin="0,0,0,3">
                                <CheckBox x:Name="UseDateFolderCheck" ToolTip="{ui:T main.useDateFolderCheck.tip}" Content="{ui:T main.useDateFolderCheck}" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="DateFormatBox" Width="200" VerticalContentAlignment="Center" ToolTip="{ui:T main.dateFormatBox.tip}"/>
                                <Button x:Name="BtnVarDate" Content="？" Padding="8,2" Margin="4,0,0,0"
                                        ToolTip="{ui:T main.btnVarDate.tip}"/>
                            </WrapPanel>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{ui:T main.save.03}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="TemplateCombo" ToolTip="{ui:T main.templateCombo.tip}" Grid.Column="1"/>
                                <WrapPanel Grid.Column="2" Margin="4,0,0,0">
                                    <Button x:Name="BtnTemplateSave" Content="{ui:T main.btnTemplateSave}" Padding="8,2" Margin="0,0,4,0"/>
                                    <Button x:Name="BtnTemplateDelete" Content="{ui:T main.btnPresetDelete}" Padding="8,2" Margin="0,0,4,0"/>
                                    <Button x:Name="BtnTemplateReset" ToolTip="{ui:T main.btnTemplateReset.tip}" Content="{ui:T main.btnTemplateReset}" Padding="8,2"/>
                                </WrapPanel>
                            </Grid>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{ui:T main.save.04}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TemplateBox" Grid.Column="1" VerticalContentAlignment="Center"/>
                                <Button x:Name="BtnVarTemplate" Grid.Column="2" Content="？" Padding="8,2" Margin="4,0,0,0"
                                        ToolTip="{ui:T main.btnVarDate.tip}"/>
                            </Grid>
                            <TextBlock x:Name="TemplatePreview" TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="SemiBold"/>
                            <Expander Header="{ui:T main.savedetail.01}" Margin="0,2,0,0">
                                <StackPanel Margin="0,4,0,0">
                            <TextBlock x:Name="TemplateHint" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,2"
                                       Text="{ui:T main.templateHint}"/>
                            <WrapPanel Margin="0,0,0,3">
                                <TextBlock Text="{ui:T main.savedetail.02}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="TimeStyleCombo" MinWidth="250"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="{ui:T main.savedetail.03}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="NoBox" Width="56" VerticalContentAlignment="Center" Margin="0,0,12,0"
                                         ToolTip="{ui:T main.noBox.tip}"/>
                                <TextBlock Text="{ui:T main.savedetail.04}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="TrackBox" Width="56" VerticalContentAlignment="Center"
                                         ToolTip="{ui:T main.trackBox.tip}"/>
                            </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{ui:T main.split.01}" Margin="0,0,0,6" Padding="6,4">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,3">
                                <TextBlock Text="{ui:T main.split.02}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="AutoSplitBox" Width="76" VerticalContentAlignment="Center" TextAlignment="Center"
                                         ToolTip="{ui:T main.autoSplitBox.tip}"/>
                                <TextBlock Text="{ui:T main.split.03}" VerticalAlignment="Center" Margin="4,0,14,0"/>
                                <TextBlock Text="{ui:T main.split.04}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="MaxHoursBox" Width="40" VerticalContentAlignment="Center"
                                         ToolTip="{ui:T main.maxHoursBox.tip}"/>
                                <TextBlock Text="{ui:T main.split.05}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </WrapPanel>
                            <TextBlock x:Name="SplitHint" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock x:Name="SplitError" Foreground="#E5484D" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,4"/>
                            <Expander Header="{ui:T main.splitopt.01}" Margin="0,2,0,0">
                                <StackPanel Margin="0,4,0,0">
                            <WrapPanel Margin="0,0,0,3">
                                <CheckBox x:Name="SilenceSplitCheck" ToolTip="{ui:T main.silenceSplitCheck.tip}" Content="{ui:T main.silenceSplitCheck}" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="SilenceDbBox" ToolTip="{ui:T main.silenceDbBox.tip}" Width="46" VerticalContentAlignment="Center"/>
                                <TextBlock Text="{ui:T main.splitopt.02}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                                <TextBox x:Name="SilenceSecBox" ToolTip="{ui:T main.silenceSecBox.tip}" Width="40" VerticalContentAlignment="Center"/>
                                <TextBlock Text="{ui:T main.splitopt.03}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                                <TextBox x:Name="MinTrackBox" ToolTip="{ui:T main.minTrackBox.tip}" Width="40" VerticalContentAlignment="Center"/>
                                <TextBlock Text="{ui:T main.splitopt.04}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,3">
                                <CheckBox x:Name="AutoStartCheck" ToolTip="{ui:T main.autoStartCheck.tip}" Content="{ui:T main.autoStartCheck}" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="AutoStartDbBox" ToolTip="{ui:T main.autoStartDbBox.tip}" Width="46" VerticalContentAlignment="Center"/>
                                <TextBlock Text="{ui:T main.splitopt.05}" VerticalAlignment="Center" Margin="4,0,14,0"/>
                                <TextBlock Text="{ui:T main.splitopt.06}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="AutoStopBox" ToolTip="{ui:T main.autoStopBox.tip}" Width="44" VerticalContentAlignment="Center"/>
                                <TextBlock Text="{ui:T main.splitopt.07}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </WrapPanel>
                            <WrapPanel>
                                <CheckBox x:Name="AutoResumeCheck" ToolTip="{ui:T main.autoResumeCheck.tip}" Content="{ui:T main.autoResumeCheck}" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="LostPolicyCombo" ToolTip="{ui:T main.lostPolicyCombo.tip}" Width="230"/>
                            </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <!-- ===== 右: モニター + タブ ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderThickness="1" BorderBrush="#55808080" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 経過時間など -->
                        <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="ElapsedText" Text="0:00:00" FontSize="34" FontWeight="SemiBold" Margin="0,0,16,0" FontFamily="Consolas, Yu Gothic UI"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="StateText" Text="{ui:T main.stateText}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TrackInfoText" Text="" Opacity="0.8"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="DiskText" Text="" Opacity="0.8"/>
                                <TextBlock x:Name="FileNameText" Text="" Opacity="0.8" TextTrimming="CharacterEllipsis" MaxWidth="460"/>
                            </StackPanel>
                        </WrapPanel>

                        <!-- ボタン -->
                        <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top">
                            <Button x:Name="BtnRecord" Content="{ui:T main.btnRecord}" Width="150" Height="46" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Button x:Name="BtnPauseRec" ToolTip="{ui:T main.btnPauseRec.tip}" Content="{ui:T main.btnPauseRec}" Width="150" Height="38" FontSize="14" IsEnabled="False" Margin="0,0,0,6"/>
                            <Button x:Name="BtnSplit" ToolTip="{ui:T main.btnSplit.tip}" Content="{ui:T main.btnSplit}" Width="150" Height="38" FontSize="14" IsEnabled="False" Margin="0,0,0,6"/>
                            <CheckBox x:Name="MonitorCheck" ToolTip="{ui:T main.monitorCheck.tip}" Content="{ui:T main.monitorCheck}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- 波形 -->
                        <Border Grid.Row="1" Grid.Column="0" Margin="0,6,0,6" BorderThickness="1" BorderBrush="#55808080">
                            <c:WaveformView x:Name="WaveView" Height="86"/>
                        </Border>

                        <!-- メーターとゲイン -->
                        <Grid Grid.Row="2" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{ui:T main.rec.01}" Opacity="0.7" Margin="0,0,0,2"/>
                                <c:LevelMeter x:Name="MasterMeter" Margin="0,0,0,6"/>
                                <TextBlock Text="{ui:T main.rec.02}" Opacity="0.7" Margin="0,0,0,2"/>
                                <c:LevelMeter x:Name="SourceMeter"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{ui:T main.rec.03}" Opacity="0.7" Margin="0,0,0,2"/>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{ui:T main.rec.04}" VerticalAlignment="Center"/>
                                    <Slider x:Name="MasterGain" Grid.Column="1" Minimum="-30" Maximum="30" Value="0" SmallChange="0.5" LargeChange="3" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MasterGainText" Grid.Column="2" Text="+0.0 dB" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GName1" Text="{ui:T main.inName1}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Slider x:Name="Gain1" Grid.Column="1" Minimum="-30" Maximum="20" Value="0" SmallChange="0.5" LargeChange="3" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Gain1Text" Grid.Column="2" Text="+0.0 dB" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <Button x:Name="FxBtn1" Grid.Column="3" Content="FX" Padding="6,0" Margin="6,0,0,0" MinWidth="30" FontSize="11" ToolTip="{ui:T main.fxBtn1.tip}"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GName2" Text="{ui:T main.inName2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Slider x:Name="Gain2" Grid.Column="1" Minimum="-30" Maximum="20" Value="0" SmallChange="0.5" LargeChange="3" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Gain2Text" Grid.Column="2" Text="+0.0 dB" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <Button x:Name="FxBtn2" Grid.Column="3" Content="FX" Padding="6,0" Margin="6,0,0,0" MinWidth="30" FontSize="11" ToolTip="{ui:T main.fxBtn1.tip}"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GName3" Text="{ui:T main.inName3}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Slider x:Name="Gain3" Grid.Column="1" Minimum="-30" Maximum="20" Value="0" SmallChange="0.5" LargeChange="3" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Gain3Text" Grid.Column="2" Text="+0.0 dB" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <Button x:Name="FxBtn3" Grid.Column="3" Content="FX" Padding="6,0" Margin="6,0,0,0" MinWidth="30" FontSize="11" ToolTip="{ui:T main.fxBtn1.tip}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GName4" Text="{ui:T main.inName4}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Slider x:Name="Gain4" Grid.Column="1" Minimum="-30" Maximum="20" Value="0" SmallChange="0.5" LargeChange="3" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Gain4Text" Grid.Column="2" Text="+0.0 dB" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <Button x:Name="FxBtn4" Grid.Column="3" Content="FX" Padding="6,0" Margin="6,0,0,0" MinWidth="30" FontSize="11" ToolTip="{ui:T main.fxBtn1.tip}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- エラー(音の鳴るポップアップではなく、ここに赤文字で出す) -->
                        <TextBlock x:Name="ErrorText" Grid.Row="3" Grid.ColumnSpan="2" Foreground="#E5484D" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6,0,0" VerticalAlignment="Top"/>
                        <!-- メッセージ -->
                        <ListBox x:Name="LogList" Grid.Row="4" Grid.ColumnSpan="2" Height="64" Margin="0,6,0,0" FontSize="11"/>
                    </Grid>
                </Border>

                <TabControl x:Name="Tabs" Grid.Row="1">
                    <TabItem Header="{ui:T main.files.01}">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- プレイヤー -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnPlay" Grid.Column="0" Content="{ui:T main.btnPlay}" Width="72" Margin="0,0,4,0"/>
                                <Button x:Name="BtnStopPlay" Grid.Column="1" Content="■" Width="36" Margin="0,0,8,0"/>
                                <Slider x:Name="SeekSlider" Grid.Column="2" Minimum="0" Maximum="1" VerticalAlignment="Center" IsMoveToPointEnabled="True"/>
                                <TextBlock x:Name="PlayPosText" Grid.Column="3" Text="0:00 / 0:00" Margin="8,0,8,0" VerticalAlignment="Center" MinWidth="96" TextAlignment="Center"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,8,0">
                                    <TextBlock Text="{ui:T main.files.02}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox x:Name="SpeedCombo" Width="78"/>
                                </StackPanel>
                                <StackPanel Grid.Column="5" Orientation="Horizontal">
                                    <TextBlock Text="{ui:T main.files.03}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Slider x:Name="VolumeSlider" Width="80" Minimum="0" Maximum="1" Value="0.8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- 一覧(Windows 11のFluentテーマではGridViewが表示されないため、1行ずつのテンプレートで作る) -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="12,0,0,3" Opacity="0.75">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="360"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{ui:T main.save.04}"/>
                                    <TextBlock Grid.Column="1" Text="{ui:T main.files.04}" TextAlignment="Right" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="2" Text="{ui:T main.files.05}" TextAlignment="Right" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="3" Text="{ui:T main.files.06}"/>
                                </Grid>
                                <ListView x:Name="FileList" Grid.Row="1" SelectionMode="Extended">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="360"/>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="76"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DurationText}" TextAlignment="Right" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" TextAlignment="Right" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding TimeText}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>

                            <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                                <Button x:Name="BtnReveal" Content="{ui:T main.btnReveal}" Padding="10,2" Margin="0,0,6,0"/>
                                <Button x:Name="BtnRename" Content="{ui:T main.btnRename}" Padding="10,2" Margin="0,0,6,0"/>
                                <Button x:Name="BtnTrash" Content="{ui:T main.btnTrash}" Padding="10,2" Margin="0,0,6,0"/>
                                <Button x:Name="BtnRescan" Content="{ui:T main.btnRescan}" Padding="10,2" Margin="0,0,12,0"/>
                                <TextBlock Text="{ui:T main.files.07}" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.8"/>
                                <TextBox x:Name="FileFilterBox" Width="130" Margin="0,0,10,0" VerticalContentAlignment="Center"
                                         ToolTip="{ui:T main.fileFilterBox.tip}"/>
                                <TextBlock x:Name="FileCountText" VerticalAlignment="Center" Opacity="0.7"/>
                                <TextBlock x:Name="FileError" VerticalAlignment="Center" Foreground="#E5484D" FontWeight="SemiBold" Visibility="Collapsed" Margin="12,0,0,0"/>
                            </WrapPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{ui:T main.tags.01}">
                        <StackPanel Margin="10">
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                                       Text="{ui:T main.tags.02}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{ui:T main.tags.03}" VerticalAlignment="Center"/>
                                <TextBox x:Name="TagTitle" Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{ui:T main.tags.04}" VerticalAlignment="Center"/>
                                <TextBox x:Name="TagArtist" Grid.Row="0" Grid.Column="4" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{ui:T main.tags.05}" VerticalAlignment="Center"/>
                                <TextBox x:Name="TagAlbum" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{ui:T main.tags.06}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <TextBox x:Name="TagAlbumArtist" Grid.Row="1" Grid.Column="4" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{ui:T main.tags.07}" VerticalAlignment="Center"/>
                                <TextBox x:Name="TagGenre" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{ui:T main.tags.08}" VerticalAlignment="Center"/>
                                <TextBox x:Name="TagYear" Grid.Row="2" Grid.Column="4" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{ui:T main.tags.09}" VerticalAlignment="Center"/>
                                <TextBox x:Name="TagComment" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,0,0,4"/>
                            </Grid>
                            <CheckBox x:Name="WriteTrackTagCheck" Margin="0,8,0,0"
                                      Content="{ui:T main.writeTrackTagCheck}"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="{ui:T main.app.01}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <TextBlock Text="{ui:T main.app.02}" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ConfirmCloseCheck" Content="{ui:T main.confirmCloseCheck}" Margin="0,0,0,8"/>
                                <WrapPanel Margin="0,0,0,4">
                                    <CheckBox x:Name="HotkeysCheck" Content="{ui:T main.hotkeysCheck}" Margin="0,0,12,0" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="{ui:T main.app.03}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="HotkeyStartBox" Width="120" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="{ui:T main.app.04}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="HotkeyPauseBox" Width="120" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="{ui:T main.app.05}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="HotkeySplitBox" Width="120" VerticalContentAlignment="Center"/>
                                </WrapPanel>
                                <TextBlock x:Name="HotkeyStatus" Opacity="0.75" Margin="0,0,0,8" TextWrapping="Wrap"
                                           Text="{ui:T main.hotkeyStatus}"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock Text="{ui:T main.app.06}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="DiskWarnBox" Width="46" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="{ui:T main.app.07}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                                    <TextBox x:Name="DiskStopBox" Width="46" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="{ui:T main.app.08}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </WrapPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{ui:T main.app.09}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="FfmpegBox" Grid.Column="1" VerticalContentAlignment="Center" ToolTip="{ui:T main.ffmpegBox.tip}"/>
                                    <Button x:Name="BtnFfmpegBrowse" Grid.Column="2" Content="{ui:T main.btnBrowse}" Padding="8,2" Margin="4,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="FfmpegStatus" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock x:Name="DataDirText" Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{ui:T main.schedule.01}">
                        <StackPanel Margin="10">
                            <CheckBox x:Name="ScheduleCheck" Content="{ui:T main.scheduleCheck}" Margin="0,0,0,8"/>
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="{ui:T main.schedule.02}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <DatePicker x:Name="ScheduleDate" Width="140" Margin="0,0,12,0"/>
                                <TextBlock Text="{ui:T main.schedule.03}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="ScheduleTimeBox" Width="60" VerticalContentAlignment="Center" Margin="0,0,12,0" ToolTip="{ui:T main.scheduleTimeBox.tip}"/>
                                <TextBlock Text="{ui:T main.schedule.04}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="ScheduleMinutesBox" Width="60" VerticalContentAlignment="Center"/>
                                <TextBlock Text="{ui:T main.schedule.05}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </WrapPanel>
                            <CheckBox x:Name="ScheduleDailyCheck" Content="{ui:T main.scheduleDailyCheck}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="ScheduleStatus" Opacity="0.8" TextWrapping="Wrap"/>
                            <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="{ui:T main.schedule.06}"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ===== ステータスバー ===== -->
        <DockPanel Grid.Row="2" Margin="8,2,8,6" LastChildFill="True">
            <TextBlock x:Name="StatusText" Text="" Opacity="0.85" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
